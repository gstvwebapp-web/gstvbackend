.googlePreview p:first-child { color: rgb(0, 0, 238); font-size: 16px; margin-bottom: 2px; overflow-x: hidden; text-decoration: underline; white-space: nowrap; }

.googlePreview p:nth-child(2) { color: rgb(0, 128, 42); font-size: 14px; }

.centerTable th, .centerTable td { text-align: center; }

.altImgGroup { padding-left: 10px; }

