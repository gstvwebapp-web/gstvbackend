.errorBox { background: url("../img/wrong.png") 1px top no-repeat scroll transparent; padding-left: 26px; }

.improveBox { background: url("../img/info.png") 1px top no-repeat scroll transparent; padding-left: 26px; }

.lowImpactBox { background: url("../img/low.png") 1px top no-repeat scroll transparent; padding-left: 26px; }

.seoBox .questionBox { position: absolute; right: 15px; top: 75px; z-index: 1029; }

