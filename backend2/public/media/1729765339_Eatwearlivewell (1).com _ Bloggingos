.solveMsgGreen { color: rgb(22, 160, 133); }

.seoBox { position: relative; cursor: pointer; padding: 10px; border: 1px solid rgb(255, 255, 255); opacity: 0.8; margin-bottom: 5px; }

.seoBox:hover { cursor: pointer; border: 1px solid rgb(238, 238, 238); background: none 0px 0px repeat scroll rgb(255, 255, 255); opacity: 1; }

.seoBox:hover .headBox { background-color: rgb(246, 246, 246); }

.bottom5 { margin-bottom: 5px; }

.bottom10 { margin-bottom: 10px; }

