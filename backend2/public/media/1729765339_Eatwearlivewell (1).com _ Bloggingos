.levelBox { width: 45%; }

.progressBox { padding: 8px 8px 8px 0px; }

.mainLink { font-size: 20px; }

.timeBox { margin-bottom: 10px; }

.circleBox { margin-top: 40px; }

.circle { display: inline-block; line-height: 1.2; margin: 6px 6px -35px; position: relative; text-align: center; width: 130px; }

.circle canvas { vertical-align: top; }

.circle strong { font-size: 32px; color: rgb(58, 181, 219); left: 0px; line-height: 40px; position: absolute; text-align: center; top: 43px; width: 100%; }

.circle strong i { font-size: 0.6em; font-style: normal; font-weight: 400; }

#scoreBoard .scoreProgress-label { width: 100px; }

