.line { border-bottom: 1px solid rgb(238, 238, 238); float: left; margin-bottom: 18px; padding: 8px 0px 0px; width: 100%; }

.headBox { border-radius: 5px; margin-bottom: 10px; background-color: rgb(248, 248, 248); border: 1px solid rgb(238, 238, 238); }

