.keywordsTags .keyword { padding: 0px 6px; }

.keywordsTags .number { background: none 0px 0px repeat scroll rgb(70, 147, 213); border-radius: 0px 3px 3px 0px; color: rgb(255, 255, 255); display: inline-block; height: 18px; padding: 0px 6px; }

.hide { display: none; }

.progress-bar-striped, .progress-striped { background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.15) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, 0.15) 50%, rgba(255, 255, 255, 0.15) 75%, transparent 75%, transparent); background-size: 40px 40px; }

.progress-bar-darkgreen { background-color: rgb(22, 160, 133); }

.padLeft10 { padding-left: 10px; }

