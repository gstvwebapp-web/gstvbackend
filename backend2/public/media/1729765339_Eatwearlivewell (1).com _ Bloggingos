.grayColor { color: rgb(166, 166, 166); }

.tooltip-inner { white-space: pre-wrap; min-width: 100px; }

.passedBox .suggestionBox { background-color: rgb(175, 218, 175); }

.errorBox .suggestionBox { background-color: rgb(241, 181, 181); }

.improveBox .suggestionBox { background-color: rgb(251, 218, 180); }

.lowImpactBox .suggestionBox { background-color: rgb(224, 224, 224); }

.suggestionBox { border-radius: 5px; margin-bottom: 3px; margin-top: 10px; padding: 15px; display: none; }

.showLess { display: none; }

.showLinks { text-align: center; }

