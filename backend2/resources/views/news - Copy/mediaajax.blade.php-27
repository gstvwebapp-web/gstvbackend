                        @csrf
                    
                    </form>
                    
                    <script>
                        Dropzone.options.myDropzone = {
                            paramName: "images", // The name that will be used to transfer the file
                            maxFilesize: 100, // MB
                            acceptedFiles: "image/*",
                            dictDefaultMessage: "Drop images here or click to upload",
                            addRemoveLinks: true,
                            init: function () {
                                this.on("success", function (file, response) {
                                    // Handle success
                                    file.previewElement.setAttribute("data-image-id", response.imageId);
                                    loadMorePostNews(1);
                                    console.log(response);
                                });
                    
                                this.on("removedfile", function (file) {
                                   var imageId = file.previewElement.getAttribute("data-image-id");
                                    $.ajax({
                                        url: "{{ url('/mediagallery/delete-image/') }}/"+imageId,
                                        headers: {
                                            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                                        },
                                        success: function (response) {
                                            // Handle success
                                            loadMorePostNews(1);
                                        },
                                        error: function (xhr, status, error) {
                                            // Handle error
                                            console.error(xhr.responseText);
                                        }
                                    });
                                });
                            }
                        };
    function loadMorePostNews(nextPage) {
    if(nextPage!=1)
    {
        if(nextPage=='')
        {
            var nextPageUrl = document.getElementById('newsloadMoreBtn').getAttribute('data-next-page');
            var pageNum = nextPageUrl.split('=').pop(); 
            nextPage = pageNum;
        }
        
    }
    $.ajax({
        url: "{{ url('/news/loadmoredata?page=') }}"+nextPage+"&nid="+$('#nid').val(),
        type: 'GET',
        dataType: 'html',
        success: function (response) {
            // Append the new posts to the container
            var responsedata = JSON.parse(response);
            var html = '';
            $.each(responsedata.data, function(index, item) {
              var extension = item.photos.split('.').pop();
              
              var pdfval = '';
              var imgpath = item.fullpath;
              
              if(extension=='pdf')
              {
                pdfval = "{{asset('public/media').'/pdficon.jpg'}}";
                imgpath = pdfval;
              } else if(extension=='webp')
              {
                pdfval = imgpath;
                imgpath = imgpath.replace('.webp', '_small.webp');
              } else {
                var dotIndex  = imgpath.lastIndexOf('.');
                var filePathWithoutExtension;
                if (dotIndex !== -1 && dotIndex > 0) {
                  filePathWithoutExtension = imgpath.slice(0, dotIndex);
                } 
                pdfval = filePathWithoutExtension+'_video.gif';
                imgpath = pdfval;
              }
              
              html +='<div class="col-lg-2 mediacls">'
              html +='<img style="cursor:pointer" id="photo_'+item.id+'" src="'+imgpath+'" onclick="ImageSelect(\'' + item.fullpath + '\', \'' + pdfval + '\', \'photo_' + item.id + '\')" class="img-fluid rounded" />'
              html +='</div>'
            });
            if(nextPage!=1)
            {
                $('#mediaContainer').append(html);
            } else {
                $('#imageList').html(html);
            }
            
            var nextPageUrl = responsedata.next_page_url;
            $('#newsloadMoreBtn').show();
            if(nextPageUrl==null)
            {
              $('#newsloadMoreBtn').hide();
            }
            $('#newsloadMoreBtn').attr('data-next-page', nextPageUrl);
        },
        error: function (xhr, status, error) {
            console.error('Error loading more posts:', error);
        }
    });
}


                    </script>
                    
      
      </div>
