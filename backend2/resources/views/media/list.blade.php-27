    @csrf

</form>
</div>
<script>
    Dropzone.options.myDropzone = {
        paramName: "images", // The name that will be used to transfer the file
        maxFilesize: 200, // MB
        acceptedFiles: "image/*,video/*,application/pdf",
        dictDefaultMessage: "Drop images here or click to upload",
        addRemoveLinks: true,
        init: function () {
            this.on("success", function (file, response) {
                // Handle success
                file.previewElement.setAttribute("data-image-id", response.imageId);
                console.log(response);
            });

            this.on("removedfile", function (file) {
               var imageId = file.previewElement.getAttribute("data-image-id");
                $.ajax({
                    url: "{{ url('/mediagallery/delete-image/') }}/"+imageId,
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                    },
                    success: function (response) {
                        // Handle success
                        console.log(response);
                    },
                    error: function (xhr, status, error) {
                        // Handle error
                        console.error(xhr.responseText);
                    }
                });
            });
        }
    };
    
</script>

            </div>
              
            <div class="row mt-3">
              @foreach($data['media'] as $item)
                  @php
                    $extension = pathinfo($item->photos, PATHINFO_EXTENSION);
                    $filePathWithoutExtension = pathinfo($item->fullpath, PATHINFO_DIRNAME) . '/' . pathinfo($item->fullpath, PATHINFO_FILENAME);
                    $filePathWithoutExtension = $filePathWithoutExtension.'_video.gif';
                  @endphp
                  <div class="col-lg-2 mediacls">
                    @if($extension=='pdf')
                    <img style="cursor:pointer" src="{{asset('public/media').'/pdficon.jpg'}}" onclick="toggleDrawer({{$item->id}})" class="img-fluid rounded border" />
                    @elseif($extension=='webp')
                    <img style="cursor:pointer" src="{{ str_replace('.webp', '_small.webp', $item->fullpath) }}" onclick="toggleDrawer({{$item->id}})" class="img-fluid rounded border" />
                    @else
                    <img style="cursor:pointer" src="{{$filePathWithoutExtension}}" onclick="toggleDrawer({{$item->id}})" class="img-fluid rounded border" />
